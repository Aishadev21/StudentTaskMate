<?xml version="1.0" encoding="utf-8"?>
<!-- activity_add_task.xml: the ADD TASK screen.
     The root keeps android:id="@+id/main" because AddTaskActivity.java
     uses it for the edge-to-edge padding, like MainActivity does. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/purple_light"
    android:orientation="vertical"
    tools:context=".AddTaskActivity">

    <!-- HEADER: primary purple, white title -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/purple_primary"
        android:padding="16dp"
        android:text="@string/add_task_title"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold" />

    <!-- ScrollView: lets the screen scroll if the keyboard covers part of it -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- WHITE CARD holding the form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Task title field. TextInputLayout draws the border,
                     the floating label and the error message.
                     TextInputEditText inside it is an EditText. -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/layoutTaskTitle"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/task_title_label"
                    app:boxBackgroundColor="@color/white"
                    app:boxStrokeColor="@color/border_color"
                    app:hintTextColor="@color/purple_primary"
                    app:placeholderText="@string/task_title_hint"
                    app:placeholderTextColor="@color/text_grey">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/editTaskTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textCapSentences"
                        android:maxLength="80"
                        android:minHeight="56dp"
                        android:singleLine="true"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Priority label -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/choose_priority"
                    android:textColor="@color/text_dark"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <!-- Priority choice: only ONE radio button can be selected.
                     Medium is selected by default. Each button is 48dp tall. -->
                <RadioGroup
                    android:id="@+id/radioGroupPriority"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/radioLow"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/priority_low"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        app:buttonTint="@color/purple_primary" />

                    <RadioButton
                        android:id="@+id/radioMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:minHeight="48dp"
                        android:text="@string/priority_medium"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        app:buttonTint="@color/purple_primary" />

                    <RadioButton
                        android:id="@+id/radioHigh"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="@string/priority_high"
                        android:textColor="@color/text_dark"
                        android:textSize="16sp"
                        app:buttonTint="@color/purple_primary" />
                </RadioGroup>
            </LinearLayout>

            <!-- BUTTONS: Cancel (white) and Save (primary purple), 56dp tall -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <Button
                    tools:ignore="ButtonStyle"
                    android:id="@+id/buttonCancel"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/white"
                    android:text="@string/cancel_button"
                    android:textColor="@color/purple_primary"
                    android:textSize="18sp" />

                <Button
                    tools:ignore="ButtonStyle"
                    android:id="@+id/buttonSave"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:backgroundTint="@color/purple_primary"
                    android:text="@string/save_button"
                    android:textColor="@color/white"
                    android:textSize="18sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
